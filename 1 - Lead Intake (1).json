    {
      "parameters": {
        "jsCode": "const DUP_MINUTES = 2; // blocks accidental double-submits but allows quick demo retakes. Use 1440 (24h) in production.\nconst form = $('Clean Phone').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.id !== undefined && r.id !== null);\nconst text = (v) => (v === null || v === undefined) ? '' : String(v).trim();\nconst name = text(form.Name).slice(0, 60);\nconst interest = text(form['Looking for']).slice(0, 80);\nconst phone = text(form.phone_clean);\nconst consentRaw = form['WhatsApp consent'];\nconst consent = Array.isArray(consentRaw) ? consentRaw.length > 0 : !!consentRaw;\nconst bad = /https?:|www[.]|[<>]/i;\nlet reason = '';\nlet msg = '';\nif (!consent) {\n  reason = 'consent';\n  msg = 'Please tick the consent box so we can message you on WhatsApp, then submit the form again.';\n} else if (!/^[1-9][0-9]{9,14}$/.test(phone)) {\n  reason = 'phone';\n  msg = 'That phone number does not look valid. Please include your country code, for example 923001234567, and submit the form again.';\n} else if (name.length < 2 || interest.length < 2 || bad.test(name) || bad.test(interest)) {\n  reason = 'invalid';\n  msg = 'Please check your name and what you are looking for, then submit the form again.';\n} else if (rows.some((r) => text(r.status) === 'stopped')) {\n  reason = 'optout';\n  msg = 'You previously asked us to stop messaging you, so we cannot contact you on WhatsApp.';\n} else if (rows.some((r) => (Date.now() - new Date(r.createdAt).getTime()) < DUP_MINUTES * 60000)) {\n  reason = 'duplicate';\n  msg = 'We have just received your request. Please check your WhatsApp chat and reply there.';\n}\nreturn [{ json: { ...form, Name: name, 'Looking for': interest, ok: reason === '', reason, reason_text: msg } }];\n"
      },
